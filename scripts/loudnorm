#!/usr/bin/env bash
# Two-pass loudness normalisation to -14 LUFS / -1 dBTP, video stream copied. Usage: loudnorm in.mp4 out.mp4
set -euo pipefail
J=$(ffmpeg -hide_banner -i "$1" -af loudnorm=I=-14:TP=-1:LRA=7:print_format=json -f null - 2>&1 | sed -n '/^{/,/^}/p')
g(){ echo "$J" | python3 -c "import json,sys;print(json.load(sys.stdin)['$1'])"; }
ffmpeg -v error -y -i "$1" -c:v copy -af "loudnorm=I=-14:TP=-1:LRA=7:measured_I=$(g input_i):measured_TP=$(g input_tp):measured_LRA=$(g input_lra):measured_thresh=$(g input_thresh):offset=$(g target_offset):linear=true" -c:a aac -b:a 256k -ar 48000 "$2"
ffmpeg -hide_banner -i "$2" -af ebur128 -f null - 2>&1 | grep "I:" | tail -1
